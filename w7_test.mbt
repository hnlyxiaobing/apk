///|
/// 轨 A APK：classes.dex + lib/arm64-v8a/libnative.so（结构化动态库）。
fn w7_apk() -> Bytes {
  build_zip(
    [
      zspec(
        "classes.dex", b"dex\n035\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
      ),
      zspec("lib/arm64-v8a/libnative.so", w7_fixture_so()),
    ],
    None,
  )
}

///|
/// T-W7-2：全链路黄金——容器归类 × ELF 头交叉校验 × needed × JNI 导出 × marker 命中。
test "W7 T-W7-2 full-chain golden over deterministic ELF fixture" {
  let apk = @apk.Apk::open(w7_apk())
  let libs = apk.native_libs(None)
  assert_eq(libs.length(), 1)
  let l = libs[0]
  assert_eq(abi_str(l.abi), "Arm64V8a")
  assert_eq(l.path, "lib/arm64-v8a/libnative.so")
  assert_eq(l.bytes.length(), 510)
  // ELF 头交叉校验：目录 ABI == 内容 ABI。
  assert_eq(abi_str(l.elf_abi()), "Arm64V8a")
  let info = l.elf_info()
  // DT_NEEDED -> libnative.so
  assert_eq(info.needed.length(), 1)
  assert_eq(info.needed[0], "libnative.so")
  // JNI 导出：Java_foo_bar
  assert_eq(info.jni_exports.length(), 1)
  assert_eq(info.jni_exports[0], "Java_foo_bar")
  // Dart AOT marker 命中（两个 _kDart*）。
  assert_eq(info.dart_markers.length(), 2)
  assert_eq(info.dart_markers[0], "_kDartVmSnapshotInstructions")
  assert_eq(info.dart_markers[1], "_kDartIsolateSnapshotData")
}

///|
/// T-W7-2（续）：便利函数通道与 elf_info 一致（needed_libraries / jni_exports）。
test "W7 T-W7-2 convenience accessors match elf_info" {
  let apk = @apk.Apk::open(w7_apk())
  let l = apk.native_libs(None)[0]
  assert_eq(l.needed_libraries(), l.elf_info().needed)
  assert_eq(l.jni_exports(), l.elf_info().jni_exports)
}
