///|
fn fx_join(lines : Array[String]) -> String {
  let mut s = ""
  let mut first = true
  for l in lines {
    if first {
      first = false
    } else {
      s = s + "\n"
    }
    s = s + l
  }
  s + "\n"
}

///|
/// 容器侧黄金规范化（与 fixtures/golden/apk/<id>.apkparse.norm.txt 同构）：
/// ENTR（中央目录条目）+ DEX（classes*.dex 列表）+ MANI/ARSC 字节长 + LIB（ABI）。
/// ABI 来自 aapt2 badging 的 native-code；本样本无 .so，故无 LIB 行。
fn fx_canon_apk(a : @apk.Apk) -> String raise @apk.ApkError {
  let out : Array[String] = []
  for e in a.entries() {
    out.push("ENTR|\{e.name}|\{e.uncompressed_size}|\{e.compressed_size}")
  }
  for d in a.dex_files() {
    out.push("DEX|\{d.name}")
  }
  let m = a.manifest()
  out.push("MANI|\{m.raw.length()}")
  match a.resource_table() {
    Some(r) => out.push("ARSC|\{r.raw.length()}")
    None => ()
  }
  fx_join(out)
}

///|
/// 签名方案黄金规范化（sig 子链，WP-4 2026-11-07 新增；与
/// fixtures/golden/apk/<id>.sig.norm.txt 同构）：固定顺序 SIG|V1|V2|V3|V31，
/// 无任何签名方案时 SIG|NONE。解析侧 = @apk.signatures() 的结构存在性检测
///（verified 字段恒为 false，不做密码学校验）。
fn fx_canon_sig(a : @apk.Apk) -> String raise @apk.ApkError {
  let names : Array[String] = []
  for s in a.signatures() {
    match s.scheme {
      V1 => names.push("V1")
      V2 => names.push("V2")
      V3 => names.push("V3")
      V31 => names.push("V31")
    }
  }
  let out : Array[String] = []
  for n in ["V1", "V2", "V3", "V31"] {
    let mut hit = false
    for m in names {
      if m == n {
        hit = true
      }
    }
    if hit {
      out.push("SIG|\{n}")
    }
  }
  if out.is_empty() {
    out.push("SIG|NONE")
  }
  fx_join(out)
}

///|
test "smoke apk real container tvshell-debug" {
  let a = @apk.Apk::open(fixture_tvshell_apk())
  assert_eq(a.entries().length(), 11)
  let dex = a.dex_files()
  assert_eq(dex.length(), 1)
  assert_eq(dex[0].name, "classes.dex")
  assert_eq(dex[0].bytes.length(), 4368)
  let m = a.manifest()
  assert_eq(m.entry_name, "AndroidManifest.xml")
  assert_true(m.raw.length() == 2128, msg="真实二进制 AXML 长度")
  assert_true(m.raw[0].to_int() == 0x03, msg="AXML RES_XML_TYPE 头")
  match a.resource_table() {
    Some(r) => assert_true(r.raw.length() == 40, msg="resources.arsc 长度")
    None => fail("tvshell 应含 resources.arsc")
  }
  assert_true(a.native_libs(None).length() == 0, msg="无 .so")
}

///|
test "smoke apk real container base" {
  let a = @apk.Apk::open(fixture_base_apk())
  assert_eq(a.entries().length(), 2)
  assert_eq(a.dex_files().length(), 0)
  let m = a.manifest()
  assert_true(m.raw.length() == 2552, msg="真实二进制 AXML 长度")
  match a.resource_table() {
    Some(r) => assert_true(r.raw.length() == 40, msg="resources.arsc 长度")
    None => fail("base 应含 resources.arsc")
  }
}

///|
test "golden apk tvshell-debug" {
  let a = @apk.Apk::open(fixture_tvshell_apk())
  assert_eq(fx_canon_apk(a), golden_tvshell_apkparse())
}

///|
test "golden apk base" {
  let a = @apk.Apk::open(fixture_base_apk())
  assert_eq(fx_canon_apk(a), golden_base_apkparse())
}

