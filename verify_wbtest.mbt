///|
/// M6-RSA-a / M6-RSA-b：`Apk::verify_signatures` 白盒端到端测试。
///
/// 合成签名 APK 由 `tmp_gen_v2_fixture.py` / `tmp_gen_v1_fixture.py` 生成（不入库）。
/// 算法 ID 遵循 Android APK Signature Scheme v2/v3 口径：
///   0x0101 = RSA-PSS + SHA-256     0x0102 = RSA-PSS + SHA-512
///   0x0103 = RSA-PKCS#1 v1.5+SHA-256  0x0104 = RSA-PKCS#1 v1.5+SHA-512
///   0x0201 = ECDSA + SHA-256（本库 fail-closed）
/// 十六进制辅助（`bytes_from_hex`/`hex_val`）复用 `rsa_wbtest.mbt`。

///|
fn fixture_apk_v2_ok() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v2_bad() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v2_pss256() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v2_pss512() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v2_sha512() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v3_ok() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v31_ok() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_ecdsa() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v1_ok() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v1_bad() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v1_noattr() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
test "T-W6-RSA-v2: valid RSA PKCS#1 v1.5 (0x0103) v2 signature verifies" {
  let apk = Apk::open(fixture_apk_v2_ok())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1, msg="one v2 signature scheme")
  let v = checks[0]
  assert_true(v.scheme is SignatureScheme::V2, msg="scheme is v2")
  assert_true(v.structure_ok, msg="signer structure is valid")
  assert_true(v.digest_ok, msg="content digest matches")
  assert_true(v.crypto_verified, msg="RSA PKCS#1 v1.5 signature verified")
  assert_eq(v.algo, "SHA256withRSA", msg="algorithm is SHA256withRSA")
}

///|
test "T-W6-RSA-v2: tampered RSA signature fails closed" {
  let apk = Apk::open(fixture_apk_v2_bad())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1, msg="one v2 signature scheme")
  let v = checks[0]
  assert_true(v.structure_ok, msg="structure is valid even with bad signature")
  assert_true(v.digest_ok, msg="digest is independent of signature tampering")
  assert_true(
    !v.crypto_verified,
    msg="crypto_verified false for tampered signature",
  )
}

///|
test "T-W6-RSA-pss: RSA-PSS SHA-256 (0x0101) verifies" {
  let apk = Apk::open(fixture_apk_v2_pss256())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1)
  let v = checks[0]
  assert_true(v.structure_ok, msg="structure ok")
  assert_true(v.digest_ok, msg="digest ok")
  assert_true(v.crypto_verified, msg="RSA-PSS SHA-256 verified")
  assert_eq(v.algo, "SHA256withRSA/PSS", msg="algo reports PSS")
}

///|
test "T-W6-RSA-pss: RSA-PSS SHA-512 (0x0102) verifies" {
  let apk = Apk::open(fixture_apk_v2_pss512())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1)
  let v = checks[0]
  assert_true(v.crypto_verified, msg="RSA-PSS SHA-512 verified (2048-bit key)")
  assert_eq(v.algo, "SHA512withRSA/PSS")
}

///|
test "T-W6-RSA-v2: PKCS#1 v1.5 SHA-512 (0x0104) verifies" {
  let apk = Apk::open(fixture_apk_v2_sha512())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1)
  let v = checks[0]
  assert_true(v.crypto_verified, msg="PKCS#1 v1.5 SHA-512 verified")
  assert_eq(v.algo, "SHA512withRSA")
}

///|
test "T-W6-RSA-v3: RSA v3 signature verifies (min/max SDK in signer block)" {
  let apk = Apk::open(fixture_apk_v3_ok())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1, msg="one v3 signature scheme")
  let v = checks[0]
  assert_true(v.scheme is SignatureScheme::V3, msg="scheme is v3")
  assert_true(v.structure_ok, msg="structure ok")
  assert_true(v.digest_ok, msg="digest ok")
  assert_true(
    v.crypto_verified,
    msg="RSA signature over v3 signed data verifies",
  )
  assert_eq(v.algo, "SHA256withRSA")
}

///|
test "T-W6-RSA-v31: RSA v3.1 signature verifies" {
  let apk = Apk::open(fixture_apk_v31_ok())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1, msg="one v3.1 signature scheme")
  let v = checks[0]
  assert_true(v.scheme is SignatureScheme::V31, msg="scheme is v3.1")
  assert_true(v.structure_ok, msg="structure ok")
  assert_true(v.digest_ok, msg="digest ok")
  assert_true(
    v.crypto_verified,
    msg="RSA signature over v3.1 signed data verifies",
  )
}

///|
test "T-W6-RSA-ecdsa: ECDSA algorithm id fails closed" {
  let apk = Apk::open(fixture_apk_ecdsa())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1)
  let v = checks[0]
  assert_true(v.structure_ok, msg="structure parses")
  assert_true(!v.crypto_verified, msg="ECDSA branch is fail-closed")
  assert_eq(v.algo, "unsupported", msg="algo reports unsupported")
}

///|
/// ECDSA P-256/P-384 真验签已按 W6 裁决 `#skip` 立项延后（仅 RSA 降级）。
/// 该测试固化「延后」决定：一旦实现 ECDSA，应移除 `#skip` 并改为真值断言。
#skip
test "T-W6-ECDSA-deferred: ECDSA verification is explicitly skipped (W6 RSA-only decision)" {
  let apk = Apk::open(fixture_apk_ecdsa())
  let checks = apk.verify_signatures()
  assert_true(
    checks[0].crypto_verified,
    msg="would require real ECDSA verification",
  )
}

///|
test "T-W6-RSA-v1: valid JAR signature verifies via CMS signerInfo" {
  let apk = Apk::open(fixture_apk_v1_ok())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1, msg="one v1 scheme")
  let v = checks[0]
  assert_true(v.scheme is SignatureScheme::V1, msg="scheme is v1")
  assert_true(v.structure_ok, msg="structure ok")
  assert_true(v.digest_ok, msg="v1 digests ok")
  assert_true(v.crypto_verified, msg="RSA signature over signedAttrs verified")
  assert_eq(v.algo, "SHA256withRSA", msg="algo SHA256withRSA")
}

///|
test "T-W6-RSA-v1: signature without signedAttrs verifies over .SF content" {
  let apk = Apk::open(fixture_apk_v1_noattr())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1)
  let v = checks[0]
  assert_true(v.structure_ok, msg="structure ok")
  assert_true(v.digest_ok, msg="digests ok")
  assert_true(v.crypto_verified, msg="RSA signature over .SF content verified")
  assert_eq(v.algo, "SHA256withRSA")
}

///|
test "T-W6-RSA-v1: tampered JAR signature fails closed" {
  let apk = Apk::open(fixture_apk_v1_bad())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1)
  let v = checks[0]
  assert_true(v.structure_ok, msg="structure still parses")
  assert_true(!v.crypto_verified, msg="tampered signature fails verification")
}
