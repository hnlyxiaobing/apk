///|
/// M6-RSA-a / M6-RSA-b：`Apk::verify_signatures` 白盒端到端测试。
///
/// 下方 11 个内嵌样本由 `tests/fixtures/gen_w6_fixtures.py` **确定性**生成
/// （Python 标准库 + `cryptography`；固定测试密钥，见脚本内 `TEST_KEY_PEM`）。
/// 校验/重生成：
///   python tests/fixtures/gen_w6_fixtures.py --check verify_wbtest.mbt
/// 样本 SHA-256 与来源口径登记在 `tests/ASSETS.md`。
/// 算法 ID 遵循 Android APK Signature Scheme v2/v3 口径：
///   0x0101 = RSA-PSS + SHA-256     0x0102 = RSA-PSS + SHA-512
///   0x0103 = RSA-PKCS#1 v1.5+SHA-256  0x0104 = RSA-PKCS#1 v1.5+SHA-512
///   0x0201 = ECDSA + SHA-256（本库 fail-closed）
/// 十六进制辅助（`bytes_from_hex`/`hex_val`）复用 `rsa_wbtest.mbt`。

///|
fn fixture_apk_v2_ok() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v2_bad() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v2_pss256() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v2_pss512() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v2_sha512() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v3_ok() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v31_ok() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_ecdsa() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v1_ok() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v1_bad() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
fn fixture_apk_v1_noattr() -> Bytes {
  bytes_from_hex(
    "",
  )
}

///|
test "T-W6-RSA-v2: valid RSA PKCS#1 v1.5 (0x0103) v2 signature verifies" {
  let apk = Apk::open(fixture_apk_v2_ok())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1, msg="one v2 signature scheme")
  let v = checks[0]
  assert_true(v.scheme is SignatureScheme::V2, msg="scheme is v2")
  assert_true(v.structure_ok, msg="signer structure is valid")
  assert_true(v.digest_ok, msg="content digest matches")
  assert_true(v.crypto_verified, msg="RSA PKCS#1 v1.5 signature verified")
  assert_eq(v.algo, "SHA256withRSA", msg="algorithm is SHA256withRSA")
}

///|
test "T-W6-RSA-v2: tampered RSA signature fails closed" {
  let apk = Apk::open(fixture_apk_v2_bad())
  let checks = apk.verify_signatures()
  assert_eq(checks.length(), 1, msg="one v2 signature scheme")
  let v = checks[0]
  assert_true(v.structure_ok, msg="structure is valid even with bad signature")
  assert_true(v.digest_ok, msg="digest is independent of signature tampering")
  assert_true(
    !v.crypto_verified,
    msg="crypto_verified false for tampered signature",
  )
}

