///|
/// 多 dex 结构冒烟：一个 APK 内两个 DEX 条目（classes.dex + classes2.dex）。
test "smoke apk multi-dex fx-multidex-v2v3" {
  let a = @apk.Apk::open(fixture_fx_multidex_v2v3_apk())
  let dex = a.dex_files()
  assert_eq(dex.length(), 2, msg="classes.dex + classes2.dex")
  let mut has1 = false
  let mut has2 = false
  for d in dex {
    if d.name == "classes.dex" {
      has1 = true
      assert_eq(d.bytes.length(), 2116, msg="桶 1 字节数")
    }
    if d.name == "classes2.dex" {
      has2 = true
      assert_eq(d.bytes.length(), 1640, msg="桶 2 字节数")
    }
  }
  assert_true(has1 && has2, msg="两个 DEX 条目都存在")
}

///|
/// 签名方案变体冒烟（WP-4）：v1-only（META-INF JAR 签名、无 Signing Block）、
/// v2/v3（Signing Block、无 META-INF 签名条目）、unsigned（无任何方案）三变体
/// 在 @apk 侧可观察区分。
test "smoke apk 签名方案变体 fx-multidex" {
  let v1 = @apk.Apk::open(fixture_fx_multidex_v1_apk())
  assert_eq(fx_canon_sig(v1), "SIG|V1\n")
  match v1.signing_block_off {
    None => ()
    Some(_) => fail("v1-only 不应有 APK Signing Block")
  }
  let v23 = @apk.Apk::open(fixture_fx_multidex_v2v3_apk())
  assert_eq(fx_canon_sig(v23), "SIG|V2\nSIG|V3\n")
  match v23.signing_block_off {
    None => fail("v2/v3 应有 APK Signing Block")
    Some(_) => ()
  }
  let u = @apk.Apk::open(fixture_fx_multidex_unsigned_apk())
  assert_eq(fx_canon_sig(u), "SIG|NONE\n")
  match u.signing_block_off {
    None => ()
    Some(_) => fail("unsigned 不应有 APK Signing Block")
  }
}
